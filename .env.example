# =============================================================
# e-financeiro — exemplo de variáveis de ambiente
# Local:  copie para `.env` (o Docker Compose lê automaticamente)
# Coolify: cadastre cada variável na aba "Environment Variables"
#          (o Coolify injeta automaticamente no docker-compose.yml)
# =============================================================

# --- Django ---
# Gere uma chave nova: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-bem-longa
DJANGO_DEBUG=False
# Domínio(s) da VPS separados por vírgula, ex.: meusistema.com.br,www.meusistema.com.br
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens CSRF (mesmos domínios, com https://), separadas por vírgula
DJANGO_CSRF_TRUSTED_ORIGINS=
# O Coolify já faz o redirecionamento HTTP->HTTPS no proxy. Deixe False.
DJANGO_SECURE_SSL_REDIRECT=False

# --- MySQL ---
MYSQL_DATABASE=efinanceiro_db
MYSQL_USER=efinanceiro
MYSQL_PASSWORD=coloque-uma-senha-forte-aqui
MYSQL_ROOT_PASSWORD=coloque-uma-senha-forte-para-o-root-aqui

# --- Gunicorn / porta (opcional) ---
# Porta publicada no host (local: http://localhost:18000)
APP_PORT=18000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
